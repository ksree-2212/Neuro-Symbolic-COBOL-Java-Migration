# AST-Guided Neuro-Symbolic RAG System Configuration

# LLM Configuration
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Embedding Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Graph Store Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
USE_EMBEDDED_GRAPH=true

# Vector Store Configuration
VECTOR_DB_PATH=workspace/vector_store.json

# Retrieval & Repair Hyperparameters
TOP_K=5
GRAPH_HOPS=2
MAX_REPAIR_ATTEMPTS=3

# Environment & Compilers (Auto-detected if left blank; specify path to JDK 17+ if installed in custom directory)
# Windows Example: JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.10.7-hotspot
# Linux Example:   JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
JAVA_HOME=
COBOL_COMPILER=builtin
NUMERIC_TOLERANCE=0.001
HOST=0.0.0.0
PORT=8000
